{
  "name": "toptechhr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TopTechHR — the HR edition of Key Personnel: four questions about an opening, a one-page plan ranked by match count and graded by evidence, the rules with their dates, the numbers beside their national twins, and a notebook that exports an action plan. The evidence is the Key Personnel content pack at a pinned tag. Not advice; no firm; nothing leaves the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:content": "tsx scripts/build-content.ts",
    "validate:hr": "python3 tools/validate_hr_layer.py hr-layer pack/key-personnel/content-pack",
    "refresh:bls": "node scripts/refresh-bls.mjs",
    "update:pack": "node scripts/update-pack.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-heading": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "docx": "^9.13.0",
    "katex": "^0.16.11",
    "minisearch": "^7.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "js-yaml": "^4.3.2",
    "jsdom": "^25.0.1",
    "papaparse": "^5.4.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  },
  "toptechhr": {
    "packTag": "pack-2026-10-22"
  }
}
